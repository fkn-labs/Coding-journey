<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Taco Town</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chango&family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles/main.css" />
</head>
<body>
  <header class="top">
    <h1>Taco Town <span aria-hidden="true">🌮</span></h1>
    <p>Pick a filling to see exactly what goes in the taco.</p>
  </header>

  <form action="/recipe" method="POST" class="picker">
    <% menu.forEach(function (m) { %>
      <% const active = recipe && recipe.id === m.id; %>
      <button type="submit" name="choice" value="<%= m.key %>" class="pick<%= active ? ' active' : '' %>" aria-pressed="<%= active %>">
        <span class="disc"><%= m.emoji %></span>
        <span class="pick-name"><%= m.name %></span>
        <span class="pick-price">$<%= m.price.toFixed(2) %></span>
      </button>
    <% }) %>
  </form>

  <main>
    <% if (!recipe) { %>
      <section class="card empty">
        <h2>Nothing on the plate yet</h2>
        <p>Choose chicken, beef or fish above to load its recipe.</p>
      </section>
    <% } else { %>
      <% const salsa = recipe.ingredients.salsa; %>
      <% const heat = { Mild: 1, Medium: 2, Hot: 3 }[salsa.spiciness] || 1; %>
      <section class="card recipe">
        <div class="recipe-head">
          <h2><%= recipe.name %></h2>
          <span class="price">$<%= recipe.price.toFixed(2) %></span>
        </div>

        <div class="block">
          <h3>Filling</h3>
          <p class="big"><%= recipe.ingredients.protein.name %>, <%= recipe.ingredients.protein.preparation.toLowerCase() %></p>
        </div>

        <div class="block">
          <h3>Salsa</h3>
          <p class="big"><%= salsa.name %></p>
          <p class="heat" aria-label="Heat: <%= salsa.spiciness %>">
            <% for (let i = 1; i <= 3; i++) { %><span class="chili<%= i <= heat ? ' on' : '' %>">🌶️</span><% } %>
            <span class="heat-label"><%= salsa.spiciness %></span>
          </p>
        </div>

        <div class="block">
          <h3>Toppings</h3>
          <ul class="toppings">
            <% recipe.ingredients.toppings.forEach(function (t) { %>
              <li>
                <div class="t-line"><strong><%= t.name %></strong><span class="qty"><%= t.quantity %></span></div>
                <div class="chips">
                  <% t.ingredients.forEach(function (ing) { %><span class="chip"><%= ing %></span><% }) %>
                </div>
              </li>
            <% }) %>
          </ul>
        </div>
      </section>
    <% } %>
  </main>
</body>
</html>
